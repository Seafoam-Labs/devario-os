{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "architecture",
    "rootTreeSha256",
    "repositorySnapshot",
    "bootstrap",
    "shellyBootstrap",
    "dependencyClosureSha256",
    "isoBuilder"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "architecture": {
      "const": "x86_64"
    },
    "rootTreeSha256": {
      "$ref": "#/$defs/sha256"
    },
    "repositorySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "databases"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://([a-z0-9-]+\\.)*[a-z0-9-]+(:[0-9]{1,5})?/snapshots/[A-Za-z0-9._-]+/$"
        },
        "databases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [
            {
              "$ref": "#/$defs/coreDb"
            }
          ],
          "items": false
        }
      }
    },
    "bootstrap": {
      "$ref": "#/$defs/signedInputWithUrl"
    },
    "shellyBootstrap": {
      "$ref": "#/$defs/signedInput"
    },
    "dependencyClosureSha256": {
      "$ref": "#/$defs/sha256"
    },
    "isoBuilder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "sha256"
      ],
      "properties": {
        "repository": {
          "const": "https://github.com/Seafoam-Labs/devario-iso-builder"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "db": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "sha256",
        "signatureSha256"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "signatureSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "coreDb": {
      "allOf": [
        {
          "$ref": "#/$defs/db"
        },
        {
          "properties": {
            "repository": {
              "const": "devario-core"
            }
          }
        }
      ]
    },
    "signedInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "size",
        "signatureSha256"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)*[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(:[0-9]{1,5})?(/[A-Za-z0-9._~!$&'()*+,;=:/-]*)?$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "signatureSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "signedInputWithUrl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "sha256",
        "size",
        "signatureSha256"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)*[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(:[0-9]{1,5})?(/[A-Za-z0-9._~!$&'()*+,;=:/-]*)?$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "signatureSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "architecture", "rootTreeSha256", "archSnapshot", "bootstrap", "shellyBootstrap", "dependencyClosureSha256"],
  "properties": {
    "schemaVersion": {"const": 1},
    "architecture": {"const": "x86_64"},
    "rootTreeSha256": {"$ref": "#/$defs/sha256"},
    "archSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "databases"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://archive\\.archlinux\\.org/repos/[0-9]{4}/[0-9]{2}/[0-9]{2}/$"},
        "databases": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "prefixItems": [
            {"$ref": "#/$defs/coreDb"},
            {"$ref": "#/$defs/extraDb"}
          ],
          "items": false
        }
      }
    },
    "bootstrap": {"$ref": "#/$defs/signedInputWithUrl"},
    "shellyBootstrap": {"$ref": "#/$defs/signedInput"},
    "dependencyClosureSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "db": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "sha256", "signatureSha256"],
      "properties": {
        "repository": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "signatureSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "coreDb": {"allOf": [{"$ref": "#/$defs/db"}, {"properties": {"repository": {"const": "core"}}}]},
    "extraDb": {"allOf": [{"$ref": "#/$defs/db"}, {"properties": {"repository": {"const": "extra"}}}]},
    "signedInput": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "size", "signatureSha256"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)*[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(:[0-9]{1,5})?(/[A-Za-z0-9._~!$&'()*+,;=:/-]*)?$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1},
        "signatureSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "signedInputWithUrl": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "sha256", "size", "signatureSha256"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)*[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(:[0-9]{1,5})?(/[A-Za-z0-9._~!$&'()*+,;=:/-]*)?$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1},
        "signatureSha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

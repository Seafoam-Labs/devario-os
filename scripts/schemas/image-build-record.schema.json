{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseMode",
    "edition",
    "releaseVersion",
    "coreCommit",
    "sourceDateEpoch",
    "inputLockSha256",
    "coreRepository",
    "isoBuilder",
    "seafoamRepository"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "releaseMode": {
      "const": true
    },
    "edition": {
      "enum": [
        "community",
        "managed"
      ]
    },
    "releaseVersion": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "coreCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "managedCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sourceDateEpoch": {
      "type": "integer",
      "minimum": 1
    },
    "inputLockSha256": {
      "$ref": "#/$defs/sha256"
    },
    "coreRepository": {
      "$ref": "#/$defs/repository"
    },
    "managedRepository": {
      "$ref": "#/$defs/repository"
    },
    "seafoamRepository": {
      "$ref": "#/$defs/repository"
    },
    "isoBuilder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "sha256"
      ],
      "properties": {
        "repository": {
          "const": "https://github.com/Seafoam-Labs/devario-iso-builder"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "edition": {
            "const": "managed"
          }
        }
      },
      "then": {
        "required": [
          "managedCommit",
          "managedRepository"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "managedCommit"
              ]
            },
            {
              "required": [
                "managedRepository"
              ]
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "activeSigner",
        "publicKeyringSha256"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)*[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(:[0-9]{1,5})?(/[A-Za-z0-9._~!$&'()*+,;=:/-]*)?$"
        },
        "activeSigner": {
          "type": "string",
          "pattern": "^[0-9A-F]{40}([0-9A-F]{24})?$"
        },
        "publicKeyringSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}

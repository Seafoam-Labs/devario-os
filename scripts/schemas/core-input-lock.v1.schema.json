{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operation", "architecture", "core", "edition", "sourceManifest", "sourceDateEpoch", "controlledBuilder", "archSnapshot", "bootstrap", "shellyBootstrap", "repositories", "keyrings"],
  "properties": {
    "schemaVersion": {"const": 1},
    "operation": {"enum": ["packages", "external-packages", "iso"]},
    "architecture": {"const": "x86_64"},
    "core": {"$ref": "#/$defs/gitIdentity"},
    "edition": {
      "type": "object",
      "required": ["id", "commit", "tree"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "commit": {"$ref": "#/$defs/sha1"},
        "tree": {"$ref": "#/$defs/sha1"},
        "path": {"type": "string"},
        "schemaVersion": {"const": 1},
        "treeListingSha256": {"$ref": "#/$defs/sha256"},
        "sourceDateEpoch": {"type": "integer", "minimum": 1},
        "archiveSha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "sourceManifest": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"const": "release/source-manifest.json"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "sourceDateEpoch": {"type": "integer", "minimum": 1},
    "releaseVersion": {"$ref": "#/$defs/releaseVersion"},
    "controlledBuilder": {
      "type": "object", "additionalProperties": false,
      "required": ["manifestSha256", "manifestSignatureSha256", "rootTreeSha256", "dependencyClosureSha256", "dependencyClosure"],
      "properties": {
        "manifestSha256": {"$ref": "#/$defs/sha256"},
        "manifestSignatureSha256": {"$ref": "#/$defs/sha256"},
        "rootTreeSha256": {"$ref": "#/$defs/sha256"},
        "dependencyClosureSha256": {"$ref": "#/$defs/sha256"},
        "dependencyClosure": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "version", "architecture"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "architecture": {"enum": ["any", "x86_64"]}
            }
          }
        }
      }
    },
    "archSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "databases"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://archive\\.archlinux\\.org/repos/[0-9]{4}/[0-9]{2}/[0-9]{2}/$"},
        "databases": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["repository", "sha256", "signatureSha256"],
            "properties": {"repository": {"enum": ["core", "extra"]}, "sha256": {"$ref": "#/$defs/sha256"}, "signatureSha256": {"$ref": "#/$defs/sha256"}}
          }
        }
      }
    },
    "bootstrap": {"$ref": "#/$defs/signedInputWithUrl"},
    "shellyBootstrap": {"$ref": "#/$defs/signedInput"},
    "managedInputLockSha256": {"$ref": "#/$defs/sha256"},
    "repositories": {
      "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
      "contains": {"properties": {"name": {"const": "devario-core"}}, "required": ["name"]},
      "items": {"$ref": "#/$defs/closure"}
    },
    "keyrings": {
      "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
      "contains": {"properties": {"name": {"const": "devario-core"}}, "required": ["name"]},
      "items": {"$ref": "#/$defs/closure"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "iso"}}, "required": ["operation"]},
      "then": {"required": ["releaseVersion"]},
      "else": {"not": {"required": ["releaseVersion"]}}
    },
    {
      "if": {
        "properties": {"operation": {"const": "iso"}, "edition": {"properties": {"id": {"const": "managed"}}, "required": ["id"]}},
        "required": ["operation", "edition"]
      },
      "then": {"required": ["managedInputLockSha256"]},
      "else": {"not": {"required": ["managedInputLockSha256"]}}
    },
    {
      "if": {
        "properties": {"operation": {"const": "iso"}, "edition": {"properties": {"id": {"const": "managed"}}, "required": ["id"]}},
        "required": ["operation", "edition"]
      },
      "then": {
        "properties": {"repositories": {"minItems": 2, "contains": {"properties": {"name": {"const": "devario-managed"}}, "required": ["name"]}}}
      },
      "else": {"properties": {"repositories": {"maxItems": 1}}}
    },
    {
      "if": {
        "anyOf": [
          {"properties": {"operation": {"const": "external-packages"}}, "required": ["operation"]},
          {"properties": {"operation": {"const": "iso"}, "edition": {"properties": {"id": {"const": "managed"}}, "required": ["id"]}}, "required": ["operation", "edition"]}
        ]
      },
      "then": {
        "properties": {"keyrings": {"minItems": 2, "contains": {"properties": {"name": {"const": "devario-managed"}}, "required": ["name"]}}}
      },
      "else": {"properties": {"keyrings": {"maxItems": 1}}}
    }
  ],
  "$defs": {
    "releaseVersion": {"type": "string", "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "commit", "tree", "treeListingSha256", "sourceDateEpoch", "archiveSha256"],
      "properties": {
        "schemaVersion": {"const": 1}, "commit": {"$ref": "#/$defs/sha1"}, "tree": {"$ref": "#/$defs/sha1"},
        "treeListingSha256": {"$ref": "#/$defs/sha256"}, "sourceDateEpoch": {"type": "integer", "minimum": 1}, "archiveSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "signedInput": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "size", "signatureSha256"],
      "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "size": {"type": "integer", "minimum": 1}, "signatureSha256": {"$ref": "#/$defs/sha256"}}
    },
    "signedInputWithUrl": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "sha256", "size", "signatureSha256"],
      "properties": {"url": {"type": "string", "pattern": "^https://([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)*[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(:[0-9]{1,5})?(/[A-Za-z0-9._~!$&'()*+,;=:/-]*)?$"}, "sha256": {"$ref": "#/$defs/sha256"}, "size": {"type": "integer", "minimum": 1}, "signatureSha256": {"$ref": "#/$defs/sha256"}}
    },
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "mode"],
      "properties": {
        "path": {"type": "string", "minLength": 1}, "mode": {"enum": ["100644", "100755", "120000"]},
        "size": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha256"}, "target": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "120000"}}, "required": ["mode"]},
          "then": {"required": ["target"], "not": {"anyOf": [{"required": ["size"]}, {"required": ["sha256"]}]}},
          "else": {"required": ["size", "sha256"], "not": {"required": ["target"]}}
        }
      ]
    },
    "closure": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "files"],
      "properties": {"name": {"enum": ["devario-core", "devario-managed"]}, "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}}}
    }
  }
}

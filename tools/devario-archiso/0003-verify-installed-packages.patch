--- a/archiso/mkarchiso
+++ b/archiso/mkarchiso
@@ -420,5 +420,27 @@ _make_packages() {
                 "${buildmode_pkg_list[@]}"
         fi
+        # Shelly currently returns success when one or more explicitly
+        # requested packages are unavailable. Refuse a partial target root
+        # before package hooks or boot-image generation obscure the cause.
+        SHELLY_ALPM_CONFIG="${generated_config}" \
+            "${devario_shelly}" list standard --show-hidden --json \
+            | python3 -c '
+import json
+import sys
+
+installed_data = json.load(sys.stdin)
+if not isinstance(installed_data, list):
+    installed_data = [installed_data]
+installed = {
+    package.get("Name")
+    for package in installed_data
+    if isinstance(package, dict) and package.get("Name")
+}
+missing = sorted(set(sys.argv[1:]) - installed)
+if missing:
+    print("Shelly did not install requested package(s): " + ", ".join(missing), file=sys.stderr)
+    raise SystemExit(1)
+' "${buildmode_pkg_list[@]}"
     ); then
         _msg_error "Shelly failed to install packages into '${pacstrap_dir}/'." 1
     fi

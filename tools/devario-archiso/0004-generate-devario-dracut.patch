--- a/archiso/mkarchiso
+++ b/archiso/mkarchiso
@@ -482,6 +482,23 @@
     _msg_info "Done!"
 }
 
+# Devario owns initramfs policy; this adapter only supplies a mounted target.
+_make_devario_initramfs() {
+    _msg_info "Generating the Devario live initramfs..."
+    if [[ -v cert_list[0] ]]; then
+        install -Dm0644 -- "${cert_list[0]}" "${pacstrap_dir}/etc/devario/live-signing.pem"
+        if [[ -v cert_list[2] ]]; then
+            cat "${cert_list[2]}" >> "${pacstrap_dir}/etc/devario/live-signing.pem"
+        fi
+    fi
+    (
+        _devario_active_mounts=()
+        trap _devario_chroot_teardown EXIT
+        _devario_chroot_setup "${pacstrap_dir}"
+        chroot "${pacstrap_dir}" /usr/lib/devario/initramfs-update --mode live
+    ) || _msg_error "Devario live initramfs generation failed." 1
+}
+
 # Customize installation.
 _make_customize_airootfs() {
     local passwd=()
@@ -1888,6 +1905,8 @@
     _run_once _make_version
     _run_once _make_customize_airootfs
     _run_once _make_pkglist
+    # Regenerate because cleanup removes /boot on completed runs.
+    _make_devario_initramfs
     if [[ "$arch" == @('x86_64'|'i686'|'i486'|'pentium4') ]]; then
         _run_once _check_if_initramfs_has_ucode
     fi
@@ -1931,6 +1950,8 @@
     _run_once _make_packages
     _run_once _make_version
     _run_once _make_pkglist

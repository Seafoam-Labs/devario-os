+# Mount the API filesystems package hooks and install scripts expect in the
+# target root. The mount list is built in reverse teardown order.
+_devario_chroot_add_mount() {
+    mount "$@" && _devario_active_mounts=("$2" "${_devario_active_mounts[@]}")
+}
+
+_devario_chroot_teardown() {
+    if (( ${#_devario_active_mounts[@]} )); then
+        umount "${_devario_active_mounts[@]}" || true
+    fi
+    _devario_active_mounts=()
+}
+
+_devario_chroot_setup() {
+    local root="$1"
+
+    install -d -m 0755 -- \
+        "${root}/var/lib/pacman" \
+        "${root}/var/cache/pacman/pkg" \
+        "${root}/var/log" \
+        "${root}/etc/pacman.d"
+    install -d -m 0555 -- "${root}/run" "${root}/dev" "${root}/sys" "${root}/proc"
+    install -d -m 1777 -- "${root}/tmp"
+
+    _devario_chroot_add_mount proc "${root}/proc" -t proc -o nosuid,noexec,nodev
+    _devario_chroot_add_mount sys "${root}/sys" -t sysfs -o nosuid,noexec,nodev,ro
+    if [[ -d "${root}/sys/firmware/efi/efivars" ]]; then

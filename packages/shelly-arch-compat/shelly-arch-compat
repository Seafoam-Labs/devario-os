"""Explicitly activate/deactivate Arch repositories; never alter installed packages."""
import argparse
import os
from pathlib import Path
import re
import subprocess
import sys

START = "# BEGIN shelly-arch-compat (managed)\n"
END = "# END shelly-arch-compat (managed)\n"
BLOCK = START + "\n[core]\nSigLevel = Required DatabaseOptional\nInclude = /etc/pacman.d/mirrorlist\n\n[extra]\nSigLevel = Required DatabaseOptional\nInclude = /etc/pacman.d/mirrorlist\n" + END
PROTECTED = {"base", "filesystem", "pacman", "shelly", "seafoam-keyring", "limine", "dracut", "mkinitcpio", "mkinitcpio-archiso"}


def protected(name):
    return name in PROTECTED or name.startswith(("devario-", "linux-devario", "linux-cachyos-"))


def change(text, activate):
    if text.count(START) != text.count(END) or text.count(START) > 1:
        raise ValueError("ambiguous compatibility block; preserve configuration for manual review")
    if activate and BLOCK in text:
        return text
    clean = re.sub(re.escape(START) + r".*?" + re.escape(END), "", text, flags=re.S)
    if activate and re.search(r"^\[(core|extra)\]", clean, re.M):
        raise ValueError("existing user-managed Arch repositories; refusing to overwrite")
    return clean + ("\n" + BLOCK if activate else "")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("enable", "disable", "guard"))
    args = parser.parse_args()
    config = Path("/etc/pacman.conf")
    text = config.read_text()
    if args.action == "guard":
        targets = [line.strip() for line in sys.stdin]
        blocked = [name for name in targets if protected(name)]
        if START in text and blocked:
            raise SystemExit("Disable Arch compatibility before changing protected Devario packages: " + ", ".join(blocked))
        return
    if os.geteuid() != 0:
        raise SystemExit("Run as root to change system repository configuration")
    result = change(text, args.action == "enable")
    if args.action == "enable":
        subprocess.run(["shelly", "keyring", "populate", "archlinux"], check=True)
    temporary = config.with_name(".shelly.conf.compat-new")
    try:
        with temporary.open("x") as stream:
            stream.write(result)
            stream.flush()
            os.fsync(stream.fileno())
        temporary.chmod(config.stat().st_mode & 0o777)
        temporary.replace(config)
    finally:
        temporary.unlink(missing_ok=True)
    if args.action == "disable":
        print("Arch repositories disabled. Existing trust keys are retained for installed-package verification.")
        print("Installed packages are unchanged; packages whose signing identity is Arch should be reviewed:")
        for desc in sorted(Path("/var/lib/pacman/local").glob("*/desc")):
            fields = desc.read_text().split("\n\n")
            values = {block.splitlines()[0]: block.splitlines()[1:] for block in fields if block.strip()}
            # Local databases do not reliably retain repository provenance.
            # Report the inventory for review, never infer an origin from names.
            print(" ".join(values.get("%NAME%", []) + values.get("%VERSION%", [])))
    else:
        print("Arch compatibility enabled. Disable it before updating protected Devario packages.")


if __name__ == "__main__":
    main()

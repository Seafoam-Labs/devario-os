package() {
  install -Dm755 "$srcdir/gpu-hotplug" "$pkgdir/usr/lib/devario/gpu-hotplug"
  install -Dm755 "$srcdir/devario-gpu-run" "$pkgdir/usr/bin/devario-gpu-run"
  install -Dm644 "$srcdir/devario-gpu-hotplug.service" "$pkgdir/usr/lib/systemd/system/devario-gpu-hotplug.service"
  install -Dm644 "$srcdir/20-devario-gpu.conf" "$pkgdir/usr/lib/systemd/user/wayland-wm@aqueous\x2dwm.service.d/20-devario-gpu.conf"
  install -Dm644 "$srcdir/devario-egpu.conf" "$pkgdir/usr/lib/modprobe.d/devario-egpu.conf"
  install -Dm644 "$srcdir/60-devario-gpu.sh" "$pkgdir/etc/xdg/uwsm/env.d/60-devario-gpu.sh"

  install -Dm755 "$srcdir/graphics-session" "$pkgdir/usr/lib/devario/graphics-session"
  install -Dm644 "$srcdir/61-devario-virtio.sh" "$pkgdir/etc/xdg/uwsm/env.d/61-devario-virtio.sh"
  install -Dm644 "$srcdir/session.toml" "$pkgdir/etc/xdg/aqueous/session.toml"
  install -Dm644 "$srcdir/greetd-config.toml" \
    "$pkgdir/usr/share/devario/greetd/config.toml"
  install -Dm755 "$srcdir/gpu-driver-setup" \
    "$pkgdir/usr/lib/devario/gpu-driver-setup"
  install -Dm644 "$srcdir/devario-gpu-driver.service" \
    "$pkgdir/usr/lib/systemd/system/devario-gpu-driver.service"
  install -Dm644 "$srcdir/greetd-gpu-driver.conf" \
    "$pkgdir/usr/lib/systemd/system/pearl-greeter.service.d/20-devario-gpu-driver.conf"
}

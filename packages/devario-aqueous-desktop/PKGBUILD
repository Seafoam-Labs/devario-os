conflicts=('aqueous-noctalia')
replaces=('aqueous-noctalia')
backup=('etc/xdg/aqueous/session.toml')
source=(
  'session.toml'
  'greetd-config.toml'
  'gpu-driver-setup'
  'devario-gpu-driver.service'
  'greetd-gpu-driver.conf'
)
sha256sums=(
  '2cecdd6b68deaedc81997669b26ddfb705c458c8de9d8fdd465aaae35eba845b'
  'f2d467b8a555bc335c5a27074660d2520636b69157fcb5137072a9b3a08bf68a'
  '533cfa381f0d7eb1ef1e5da15037992fd5f59c539cfe6d4a8f14e6d6d3aeb99f'
  'ec8e672fb2e7a451bd97ca9ccbc4ade0a91a7f0e097a5e3a6ce99ec144871807'
  'a997663d00e362e780c6d29989bcb9dfdb50d5b00142322bee207d68be8c3801'
)

package() {
  install -Dm644 "$srcdir/session.toml" "$pkgdir/etc/xdg/aqueous/session.toml"
  install -Dm644 "$srcdir/greetd-config.toml" \
    "$pkgdir/usr/share/devario/greetd/config.toml"
  install -Dm755 "$srcdir/gpu-driver-setup" \
    "$pkgdir/usr/lib/devario/gpu-driver-setup"
  install -Dm644 "$srcdir/devario-gpu-driver.service" \
    "$pkgdir/usr/lib/systemd/system/devario-gpu-driver.service"
  install -Dm644 "$srcdir/greetd-gpu-driver.conf" \
    "$pkgdir/usr/lib/systemd/system/pearl-greeter.service.d/20-devario-gpu-driver.conf"
}

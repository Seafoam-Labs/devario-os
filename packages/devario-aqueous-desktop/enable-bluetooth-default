#!/usr/bin/env bash
set -euo pipefail

# An optional root supports offline installations and migration verification.
root="${1:-/}"
state_dir="${root%/}/var/lib/devario"
marker="$state_dir/bluetooth-default-applied"
[[ ! -e "$marker" ]] || exit 0

# Apply this default once, preserving masks and later administrator choices.
state="$(systemctl --root="$root" is-enabled bluetooth.service 2>/dev/null || true)"
case "$state" in
  masked|masked-runtime) ;;
  *) systemctl --root="$root" enable bluetooth.service ;;
esac

# Use offline enablement so package/image builds never contact the host daemon.
# Bluetooth starts on the next boot; mark completion only after success.
install -d -m 0755 "$state_dir"
touch "$marker"

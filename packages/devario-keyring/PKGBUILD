pkgname=devario-keyring
pkgver=20260923
pkgrel=2
pkgdesc="Devario repository signing keys"
arch=('any')
url="https://github.com/Seafoam-Labs/devario-os"
license=('CC0-1.0')
source=(
  'devario.gpg'
  'devario-trusted'
  'devario-revoked'
  'active-signer'
)
sha256sums=(
  'e4a35b1431350637d8babb5358865953f130e3b706c0d02e3babdb5e481a576a'
  '442d605891a618ef4783f018521aac8bb609b1abb67f9db21ae4c94b642a1c03'
  'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855'
  '0a08e600db32175055ed10052427e97425f6f626c273e0e95b722ea423769cab'
)

package() {
  install -Dm644 "$srcdir/devario.gpg" \
    "$pkgdir/usr/share/shelly/keyrings/devario-core.gpg"
  install -Dm644 "$srcdir/devario-trusted" \
    "$pkgdir/usr/share/shelly/keyrings/devario-core-trusted"
  install -Dm644 "$srcdir/devario-revoked" \
    "$pkgdir/usr/share/shelly/keyrings/devario-core-revoked"
  install -Dm644 "$srcdir/active-signer" \
    "$pkgdir/usr/share/devario/keyrings/devario-core-active-signer"
}

# Maintainer: Devario maintainers
# Packaging adapted from Devario's linux-cachyos-lts recipe and Arch Linux
# kernel packaging by Jan Alexander Steffens (heftig) and contributors.

pkgbase=linux-devario
pkgname=(linux-devario linux-devario-headers)
pkgver=7.2.7
pkgrel=1
pkgdesc='Seafoam Labs Devario kernel and modules (x86-64-v3)'
arch=('x86_64')
url='https://github.com/Seafoam-Labs/linux'
license=('GPL-2.0-only')
makedepends=(
  'bc' 'binutils' 'bison' 'clang' 'cpio' 'flex' 'gcc' 'gettext' 'git' 'kmod'
  'libelf' 'llvm' 'openssl' 'pahole' 'perl' 'python' 'rust' 'rust-bindgen'
  'rust-src' 'tar' 'xxhash' 'xz' 'zstd'
)
options=('!strip' '!debug' '!lto')

# Release tags and downstream package rebuilds are independent. A pkgrel bump
# alone must not select a nonexistent upstream tag.
_tag=devario-7.2.7-1
_commit=00a4b3afc99f9413ff9ad168c2fdbe3f788eb9e5
_source_epoch=1790264627
source=(
  # Makepkg clones the private repository and verifies the signed release tag.
  # Configure Git authentication for Remora's build user outside this recipe.
  "$_tag::git+https://github.com/Seafoam-Labs/linux.git#tag=$_tag?signed"
  'config'
  'release-signing-key.pub'
)
validpgpkeys=('399521CE9D6D65B35EEF0F8C79AFA05ABDB26C5A') # Piotr Gorski
sha256sums=(
  'SKIP' # Signed Git tag; prepare() also checks its exact commit.
  '061cb499b26c8290efc6d793f6eafba8d6960e38f758b9c6e109b7b5e61f2fa0'
  '3ea1546b77e17f279f854bc5a6cf9e9393fe67d323b2df1037038ebe4c4d5a63'
)

export KBUILD_BUILD_HOST=devario
export KBUILD_BUILD_USER=devario
export KBUILD_BUILD_VERSION=1
export KBUILD_BUILD_TIMESTAMP="$(date -u -d "@${SOURCE_DATE_EPOCH:-$_source_epoch}" '+%a %b %d %T UTC %Y')"

_make() {
  # The kernel targets x86-64-v3 through config; host build tools use baseline
  # x86-64 so they do not inherit a native CPU target from the build host.
  # Suppress Git's automatic '+' suffix; localversion.10-pkgrel owns the ABI ID.
  make ARCH=x86 LLVM= LOCALVERSION= CC=gcc LD=ld.bfd HOSTCC=gcc HOSTCXX=g++ \
    HOSTCFLAGS='-O2 -march=x86-64 -mtune=generic' \
    HOSTCXXFLAGS='-O2 -march=x86-64 -mtune=generic' "$@"
}

prepare() {
  cd "$_tag"
  [[ "$(git rev-parse HEAD)" == "$_commit" ]] || {
    error 'Release tag does not match the pinned commit.'
    return 1
  }
  [[ "$(_make -s kernelversion)" == "$pkgver" ]] || {
    error 'Release source does not match pkgver.'
    return 1
  }
  cp ../config .config
  # A distinct release directory lets the old kernel remain installed.
  printf -- '-%s-devario\n' "$pkgrel" > localversion.10-pkgrel
  _make olddefconfig

  # Fail rather than silently losing the compiler, CPU, Rust, or boot policy
  # when a toolchain change causes olddefconfig to discard configuration.
  local setting
  for setting in CONFIG_CC_IS_GCC=y CONFIG_LD_IS_BFD=y \
    CONFIG_GENERIC_CPU=y CONFIG_X86_64_VERSION=3 \
    CONFIG_LTO_NONE=y CONFIG_RUST=y CONFIG_MODULES=y CONFIG_BLK_DEV_INITRD=y \
    CONFIG_EFI=y CONFIG_EFI_STUB=y CONFIG_SQUASHFS=m CONFIG_SQUASHFS_XZ=y \
    CONFIG_OVERLAY_FS=m CONFIG_BLK_DEV_LOOP=m \
    'CONFIG_LOCALVERSION=""' '# CONFIG_LOCALVERSION_AUTO is not set' \
    '# CONFIG_X86_NATIVE_CPU is not set'; do
    grep -Fxq "$setting" .config || {
      error "Required kernel configuration is missing: $setting"
      return 1
    }
  done
  _make -s kernelrelease > version
  [[ "$(<version)" == "$pkgver-$pkgrel-devario" ]] || {
    error 'Unexpected kernel release; refusing ambiguous module paths.'
    return 1
  }
}

build() {
  cd "$_tag"
  _make all
  # Required by external modules when CONFIG_DEBUG_INFO_BTF_MODULES=y.
  _make -C tools/bpf/resolve_btfids
}

package_linux-devario() {
  depends=('coreutils' 'kmod' 'dracut')
  optdepends=('linux-firmware: firmware for supported devices'
              'wireless-regdb: regulatory database for wireless devices'
              'linux-devario-headers: build external modules with DKMS')

  cd "$_tag"
  local release="$(<version)"
  local modulesdir="$pkgdir/usr/lib/modules/$release"
  install -Dm644 "$(_make -s image_name)" "$modulesdir/vmlinuz"
  printf '%s\n' "$pkgbase" | install -Dm644 /dev/stdin "$modulesdir/pkgbase"
  printf 'version=%s\nimage=vmlinuz\nid=%s\n' "$release" "$pkgbase" \
    | install -Dm644 /dev/stdin "$modulesdir/devario-kernel"
  _make INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 \
    DEPMOD=/doesnt/exist modules_install
  rm -f "$modulesdir/build" "$modulesdir/source"

  install -Dm644 .config "$pkgdir/usr/share/doc/$pkgbase/config"
  printf 'tag=%s\ncommit=%s\nkernelrelease=%s\n' "$_tag" "$_commit" "$release" \
    | install -Dm644 /dev/stdin "$pkgdir/usr/share/doc/$pkgbase/source"
}

package_linux-devario-headers() {
  pkgdesc='Headers and build tools for the Seafoam Labs Devario kernel'
  depends=("linux-devario=$pkgver-$pkgrel" 'binutils' 'gcc' 'glibc' 'libelf'
           'openssl' 'pahole' 'xxhash' 'zlib' 'zstd')
  optdepends=('clang: Rust external module bindings'
              'rust: Rust external modules'
              'rust-bindgen: Rust external module bindings')
  provides=('LINUX-HEADERS')

  cd "$_tag"
  local builddir="$pkgdir/usr/lib/modules/$(<version)/build"
  install -Dt "$builddir" -m644 .config Makefile Module.symvers System.map \
    localversion.10-pkgrel version vmlinux
  install -Dt "$builddir/kernel" -m644 kernel/Makefile
  install -Dt "$builddir/arch/x86" -m644 arch/x86/Makefile
  cp -a scripts include "$builddir/"
  cp -a arch/x86/include "$builddir/arch/x86/"
  install -Dt "$builddir/arch/x86/kernel" -m644 arch/x86/kernel/asm-offsets.s
  install -Dt "$builddir/tools/objtool" tools/objtool/objtool
  install -Dt "$builddir/tools/bpf/resolve_btfids" tools/bpf/resolve_btfids/resolve_btfids

  # Driver headers used by out-of-tree modules (including DKMS consumers).
  local header
  while IFS= read -r -d '' header; do
    install -Dm644 "$header" "$builddir/$header"
  done < <(find drivers/md net/mac80211 drivers/media/i2c \
    drivers/media/usb/dvb-usb drivers/media/dvb-frontends drivers/media/tuners \
    drivers/iio/common/hid-sensors -maxdepth 1 -name '*.h' -print0)
  find . -name 'Kconfig*' -exec install -Dm644 '{}' "$builddir/{}" \;

  # Rust metadata and proc-macro libraries are required by external Rust modules.
  install -d "$builddir/rust"
  find rust -maxdepth 1 -type f \( -name '*.rmeta' -o -name '*.so' \) \
    -exec install -m644 -t "$builddir/rust" '{}' +
  _make INSTALL_MOD_PATH="$pkgdir/usr" vdso_install link=

  # Never distribute the automatically generated module-signing private key.
  # Only scripts/include and the explicit artifacts above enter this package.
  find "$builddir" -type f -name '*.o' -delete
  find "$builddir" -type l ! -exec test -e '{}' \; -delete
  install -d "$pkgdir/usr/src"
  ln -sr "$builddir" "$pkgdir/usr/src/$pkgbase"
}

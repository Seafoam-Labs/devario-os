# Maintainer: Devario maintainers

pkgname=noctalia-greeter
pkgver=1.0.0.r0.g4aa960d
pkgrel=3
pkgdesc="Minimal Noctalia login greeter for greetd"
arch=('x86_64')
url="https://github.com/noctalia-dev/noctalia-greeter"
license=('MIT')
depends=(
  'greetd'
  'dbus'
  'wayland'
  'wayland-protocols'
  'wlroots0.20'
  'libinput'
  'libglvnd'
  'freetype2'
  'fontconfig'
  'cairo'
  'pango'
  'harfbuzz'
  'libxkbcommon'
  'glib2'
  'tomlplusplus'
  'nlohmann-json'
  'libwebp'
  'librsvg'
  'polkit'
)
provides=('greetd-greeter')
makedepends=('meson' 'ninja' 'pkgconf' 'stb')
_commit='4aa960dcff874dddd4d3d94d931df43a416ea9cf'
source=("noctalia-greeter-${_commit}.tar.gz")
sha256sums=('4e42a6056037efe6f9b162c8341d7a0514a49595e30fec2098c05ffb1b993af6')

prepare() {
  # Keep the development fallback useful without embedding the temporary
  # source directory in the shipped greeter binary.
  sed -i \
    "s|meson.project_source_root() / 'assets'|get_option('datadir') / 'noctalia-greeter' / 'assets'|" \
    "$srcdir/noctalia-greeter-1.0.0/meson.build"
}

build() {
  export CFLAGS="$CFLAGS -march=x86-64 -mtune=generic"
  export CXXFLAGS="$CXXFLAGS -march=x86-64 -mtune=generic"

  # Upstream's release build enables -march=native. The plain build type keeps
  # Devario's portable compiler and linker policy without those project flags.
  meson setup "$srcdir/build" "$srcdir/noctalia-greeter-1.0.0" \
    --prefix=/usr \
    --buildtype=plain \
    --wrap-mode=nodownload \
    -Dc_args="$CFLAGS -Wno-error=switch" \
    -Dcpp_args="$CXXFLAGS" \
    -Dc_link_args="$LDFLAGS" \
    -Dcpp_link_args="$LDFLAGS"
  meson compile -C "$srcdir/build"
}

check() {
  "$srcdir/build/noctalia-greeter" --version | grep -F '1.0.0' >/dev/null
  test -x "$srcdir/noctalia-greeter-1.0.0/scripts/noctalia-greeter-session"
}

package() {
  DESTDIR="$pkgdir" meson install -C "$srcdir/build"
  install -Dm644 "$srcdir/noctalia-greeter-1.0.0/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/noctalia-greeter-1.0.0/PACKAGING.md" \
    "$pkgdir/usr/share/doc/$pkgname/PACKAGING.md"
  install -Dm644 "$srcdir/noctalia-greeter-1.0.0/examples/greeter.toml" \
    "$pkgdir/usr/share/doc/$pkgname/greeter.toml.example"
}

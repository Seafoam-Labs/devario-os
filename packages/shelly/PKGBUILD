# Maintainer: Devario maintainers
# Upstream recipe: Seafoam Labs

pkgname=shelly
pkgver=3.1.2
pkgrel=1
_commit=2172e9512a43ac001fe82b0f3809f785df89330f
pkgdesc="Shelly: a modern libalpm package manager for Devario"
arch=('x86_64')
url="https://github.com/Seafoam-Labs/Shelly-ALPM"
license=('GPL-3.0-only')
depends=(
  'devario-alpm-runtime>=7.1.0.r9.g54d9411-2'
  'libalpm.so=16-64'
  'gtk4'
  'glib2'
  'sudo'
  'tar'
  'bash'
  'git'
  'hicolor-icon-theme'
  'dbus'
  'glibc'
  'libarchive'
  'dconf'
  'gnupg'
  'zstd'
  'json-glib'
  'polkit'
)
makedepends=(
  'clang'
  'gettext'
  'go-md2man'
  'pkgconf'
  'ripgrep'
  'zig>=0.16'
)
optdepends=(
  'fish: Fish shell completions'
  'zsh: Zsh shell completions'
  'libstarfish: dependency viewer for Arch packages'
  'shelly-flatpak-backend: Flatpak package-management support'
  'fuse2: run AppImages that require FUSE 2'
)
provides=("shelly=${pkgver}")
conflicts=('shelly-git' 'shelly-bin')
backup=('etc/shellybuild.conf')

source=(
  "${pkgname}-${pkgver}.tar.gz::https://github.com/Seafoam-Labs/Shelly-ALPM/archive/${_commit}.tar.gz"
  '0001-remove-pacman-runtime-processes.patch'
  '0002-support-alternate-alpm-config.patch'
  '0003-use-shelly-runtime-paths.patch'
)
sha256sums=(
  '202949f096b4e2715ff0928b3d8e35b5cfe80e79ca392cbad4ed2b1ab854044f'
  '7cf4a7a59f90756c6ce7c7496d0a321f0728ac93d2cf7ac64f1ce6c046ca4d6e'
  '292160e49be336d59622ed1fac0770add982184ecffef8a0d5de9822a1360922'
  'e7233d315f77291cb809eb5440241445200231dcb2a632ef73e284e29c4336ec'
)
_source_dir="Shelly-ALPM-${_commit}"

prepare() {
  cd "$srcdir/${_source_dir}"
  patch --fuzz=0 -Np1 < "$srcdir/0001-remove-pacman-runtime-processes.patch"
  patch --fuzz=0 -Np1 < "$srcdir/0002-support-alternate-alpm-config.patch"
  patch --fuzz=0 -Np1 < "$srcdir/0003-use-shelly-runtime-paths.patch"
}

build() {
  cd "$srcdir/${_source_dir}"

  (cd Shelly.Ui.Gtk && zig build --verbose \
    --prefix "$srcdir/${_source_dir}/out" \
    --cache-dir "$srcdir/zig-cache" \
    --global-cache-dir "$srcdir/zig-global-cache" \
    -Dflatpak-backend-package=shelly-flatpak-backend \
    -Dcpu=baseline \
    -Doptimize=ReleaseSafe)

  (cd Shelly.Cli.Zig && zig build --verbose \
    --prefix "$srcdir/${_source_dir}/out-cli" \
    --cache-dir "$srcdir/zig-cache" \
    --global-cache-dir "$srcdir/zig-global-cache" \
    -Dcpu=baseline \
    -Doptimize=ReleaseSmall)

  (cd Shelly.Key && zig build --verbose \
    --prefix "$srcdir/${_source_dir}/out-key" \
    --cache-dir "$srcdir/zig-cache" \
    --global-cache-dir "$srcdir/zig-global-cache" \
    -Dcpu=baseline \
    -Doptimize=ReleaseSmall)

  (cd Shelly.Notifications.Zig && zig build --verbose \
    --prefix "$srcdir/${_source_dir}/out-notifications" \
    --cache-dir "$srcdir/zig-cache" \
    --global-cache-dir "$srcdir/zig-global-cache" \
    -Dcpu=baseline \
    -Doptimize=ReleaseSmall)

  ./out-cli/bin/shelly utility --completions bash > shelly.bash
  ./out-cli/bin/shelly utility --completions fish > shelly.fish
  ./out-cli/bin/shelly utility --completions zsh > _shelly

  ./out-cli/bin/shelly utility --docs | go-md2man > shelly.1
  sed -i "s|^\\.TH .*|.TH \"SHELLY\" \"1\" \"\" \"Shelly ${pkgver}\" \"Shelly CLI Manual\"|" shelly.1
  printf '\n.SH AUTHORS\nSeafoam Labs.\n' >> shelly.1

  local po_file language
  for po_file in Shelly.Ui.Gtk/po/*.po; do
    language="$(basename "$po_file" .po)"
    msgfmt "$po_file" -o "shelly-ui-${language}.mo"
  done
  for po_file in Shelly.Notifications.Zig/po/*.po; do
    language="$(basename "$po_file" .po)"
    msgfmt "$po_file" -o "shelly-notifications-${language}.mo"
  done
}

check() {
  cd "$srcdir/${_source_dir}"

  local component
  for component in Shelly.Cli.Zig Shelly.Key Shelly.PackageManager; do
    (cd "$component" && zig build test \
      --cache-dir "$srcdir/zig-cache" \
      --global-cache-dir "$srcdir/zig-global-cache")
  done
}

package() {
  cd "$srcdir/${_source_dir}"

  install -Dm755 \
    out-notifications/bin/shelly-notifications \
    "$pkgdir/usr/bin/shelly-notifications"
  install -Dm755 \
    out/bin/Shelly_Ui_Gtk \
    "$pkgdir/usr/bin/shelly-ui"
  install -Dm755 \
    out-cli/bin/shelly \
    "$pkgdir/usr/bin/shelly"
  install -Dm755 \
    out-key/bin/shelly-key \
    "$pkgdir/usr/bin/shelly-key"
  install -Dm644 shellybuild.conf \
    "$pkgdir/etc/shellybuild.conf"

  install -Dm644 shelly.bash \
    "$pkgdir/usr/share/bash-completion/completions/shelly"
  install -Dm644 shelly.fish \
    "$pkgdir/usr/share/fish/vendor_completions.d/shelly.fish"
  install -Dm644 _shelly \
    "$pkgdir/usr/share/zsh/site-functions/_shelly"
  install -Dm644 shelly.1 \
    "$pkgdir/usr/share/man/man1/shelly.1"

  install -Dm644 assets/shellylogo.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/shelly.png"
  install -Dm644 assets/shelly-updates-symbolic.svg \
    "$pkgdir/usr/share/icons/hicolor/symbolic/apps/shelly-updates-symbolic.svg"
  install -Dm644 assets/shelly-shell-symbolic.svg \
    "$pkgdir/usr/share/icons/hicolor/symbolic/apps/shelly-shell-symbolic.svg"
  install -Dm644 assets/shellylogo-tray.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/shelly-tray.png"
  install -Dm644 assets/shellylogo-update.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/shelly-update.png"

  local mo_file language
  for mo_file in shelly-ui-*.mo; do
    language="${mo_file#shelly-ui-}"
    language="${language%.mo}"
    install -Dm644 "$mo_file" \
      "$pkgdir/usr/share/locale/$language/LC_MESSAGES/shelly-ui.mo"
  done
  for mo_file in shelly-notifications-*.mo; do
    language="${mo_file#shelly-notifications-}"
    language="${language%.mo}"
    install -Dm644 "$mo_file" \
      "$pkgdir/usr/share/locale/$language/LC_MESSAGES/shelly-notifications.mo"
  done

  install -Dm644 com.shellyorg.shelly.desktop \
    "$pkgdir/usr/share/applications/com.shellyorg.shelly.desktop"
  install -Dm644 com.shellyorg.shelly-notifications.desktop \
    "$pkgdir/usr/share/applications/com.shellyorg.shelly-notifications.desktop"

  cat <<'EOF' | install -Dm644 /dev/stdin \
    "$pkgdir/usr/share/polkit-1/actions/com.shellyorg.shelly.policy"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Shelly</vendor>
  <vendor_url>https://github.com/Seafoam-Labs/Shelly-ALPM</vendor_url>
  <action id="com.shellyorg.shelly.pkexec.cli">
    <description>Run Shelly CLI as administrator</description>
    <message>Run Shelly CLI with administrator privileges.</message>
    <icon_name>shelly</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/shelly</annotate>
  </action>
</policyconfig>
EOF

  install -Dm755 shelly-flatpak-integrate \
    "$pkgdir/usr/bin/shelly-flatpak-integrate"
}

From: Devario maintainers <maintainers@devario.local>
Subject: [PATCH] keep Shelly-owned runtime paths and builder policy

diff --git a/Shelly.Cli.Zig/src/commands/builder.zig b/Shelly.Cli.Zig/src/commands/builder.zig
--- a/Shelly.Cli.Zig/src/commands/builder.zig
+++ b/Shelly.Cli.Zig/src/commands/builder.zig
@@ -57,6 +57,13 @@
     invocation: *const parser.Invocation,
 ) !?u8 {
     if (!std.mem.eql(u8, invocation.command.path, command_path)) return null;
+    if (optionEnabled(invocation, "--isolated")) {
+        try context.stderr.writeAll(
+            "Isolated root provisioning is unavailable on Devario; use the native builder without --isolated.\n",
+        );
+        try context.stderr.flush();
+        return 1;
+    }
     var diagnostic: ?Zigalpm.pkgbuild.parser.Diagnostic = null;
     const previous_diagnostic = context.preparation_diagnostic;
     context.preparation_diagnostic = &diagnostic;
@@ -702,7 +709,6 @@
 fn shouldElevateBuildCoordinator(invocation: *const parser.Invocation, running_as_root: bool) bool {
     return !running_as_root and
         (syncDepsRequested(invocation) or
-            isolatedRequested(invocation) or
             installRequested(invocation));
 }

@@ -1738,7 +1744,7 @@
     const bindings = Zigalpm.alpm.bindings.libalpm;
     const raw = bindings.alpm;
     var alpm_error: raw.alpm_errno_t = 0;
-    const handle = raw.alpm_initialize("/", "/var/lib/pacman", &alpm_error) orelse
+    const handle = raw.alpm_initialize("/", "/var/lib/shelly", &alpm_error) orelse

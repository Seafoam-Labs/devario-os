     invocation: *const parser.Invocation,
 ) !?u8 {
     if (!std.mem.eql(u8, invocation.command.path, command_path)) return null;
+    if (optionEnabled(invocation, "--isolated")) {
+        try context.stderr.writeAll(
+            "Isolated root provisioning is unavailable on Devario; use the native builder without --isolated.\n",

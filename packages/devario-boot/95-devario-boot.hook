[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Path
Target = usr/lib/modules/*/vmlinuz
Target = usr/lib/modules/*/updates/*
Target = usr/lib/modules/*/extramodules/*
Target = usr/lib/modules/*/build/Makefile
Target = usr/src/*/dkms.conf
Target = usr/lib/firmware/*-ucode/*
Target = usr/lib/firmware/nvidia/*

[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = devario-dracut
Target = devario-boot
Target = systemd
Target = cryptsetup
Target = lvm2
Target = amd-ucode
Target = intel-ucode
Target = nvidia-open-dkms
Target = nvidia-utils
Target = linux-devario-headers
Target = linux-devario-lts-headers

[Action]
Description = Generating Devario initramfs and updating systemd-boot...
When = PostTransaction
Exec = /usr/lib/devario/boot-update

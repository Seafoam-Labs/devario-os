# SPDX-License-Identifier: GPL-3.0-or-later
[Trigger]
# A new kernel version installs a new vmlinuz path instead of upgrading the old path.
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/lib/modules/*/vmlinuz

[Action]
Description = Notifying desktop users to reboot after the kernel update...
When = PostTransaction
Exec = /usr/lib/devario/kernel-reboot-notify

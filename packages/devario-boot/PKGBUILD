pkgname=devario-boot
pkgver=1
pkgrel=7
pkgdesc="Devario kernel, dracut and systemd-boot lifecycle"
arch=('any')
url="https://github.com/Seafoam-Labs/devario-os"
license=('GPL-3.0-or-later')
depends=('devario-dracut=112' 'bash' 'coreutils' 'util-linux' 'kmod' 'systemd>=258'
         'cryptsetup' 'lvm2' 'btrfs-progs' 'e2fsprogs' 'glibc' 'gawk' 'grep' 'findutils')
source=(
  '95-devario-boot.hook'
  'boot-update'
  'initramfs-update'
  'install-root.sh'
  'installed.conf'
  'kernel-command-line'
  'kernel.sh'
  'systemd-boot-update'
  'live-root.sh'
  'live.conf'
  'module-setup.sh'
  'verify-live-image'
)
sha256sums=(
  'b22c17f2d85c274879d8a1a8dffedb5988fe167fd1f8bdc5d2daf5b1c5b69c6b'
  'f6247253c4c413f9918a5d2173b92fe60558ffdea0fae405737c0f23e6c6173f'
  'b32cbdec21d068c6c23a0a0fd3fdca2982ed378d80b16ae2d998b62bbabff967'
  '3a8807cef4c6dc0d2ef29e9ee4ef246e46203ae01371511abd6d81d4283b6da9'
  '641eaaf3241e4ccbe4423e08c905fdcef1dd846eafd0217eff6d055b1771d88d'
  '815ec97e8ee77815cb25acc3844d264ca2398cf69efc236556a14c8b4f88178c'
  'f834101b6c033b4aa5c7dbf33a91fa1fb7bc419803dc187e56f3de62b7f282df'
  '6f873b1641d2cd8ec9a0e9ceb6e9d34dc33ec054f35f0f4d6a20af5511606f56'
  '8eb5bf879dd79a24aedfa868ba820f8c3593068e668e5188be2f495ddeb6db5b'
  '34f65cc8ac7259a574b0fb6b519b7864ed57fec4c4b830c19a0865ba06c8d673'

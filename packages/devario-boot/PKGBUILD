package() {
  local file
  for file in kernel.sh kernel-command-line initramfs-update boot-update systemd-boot-update; do
    install -Dm755 "$srcdir/$file" "$pkgdir/usr/lib/devario/$file"
  done
  for file in live.conf installed.conf; do
    install -Dm644 "$srcdir/$file" "$pkgdir/usr/share/devario/dracut/$file"
  done
  for file in module-setup.sh live-root.sh install-root.sh verify-live-image; do
    install -Dm755 "$srcdir/$file" "$pkgdir/usr/lib/dracut/modules.d/91devario-live/$file"
  done
  install -Dm644 "$srcdir/95-devario-boot.hook" "$pkgdir/usr/share/rlpm/hooks/95-devario-boot.hook"
  install -dm755 "$pkgdir/etc/shelly.d/hooks"
  for file in 60-dracut-remove 90-dracut-install 60-mkinitcpio-remove 90-mkinitcpio-install 95-devario-limine; do
    ln -s /dev/null "$pkgdir/etc/shelly.d/hooks/$file.hook"
  done
}

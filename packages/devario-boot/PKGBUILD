pkgname=devario-boot
pkgver=1
pkgrel=10
pkgdesc="Devario kernel, dracut and systemd-boot lifecycle"
arch=('any')
url="https://github.com/Seafoam-Labs/devario-os"
license=('GPL-3.0-or-later')
depends=('devario-dracut=112' 'bash' 'coreutils' 'util-linux' 'kmod' 'systemd>=258'
         'cryptsetup' 'lvm2' 'btrfs-progs' 'e2fsprogs' 'glibc' 'gawk' 'grep' 'findutils')
source=(
  '95-devario-boot.hook'
  'boot-update'
  'initramfs-update'
  'install-root.sh'
  'installed.conf'
  'kernel-command-line'
  'kernel.sh'
  'systemd-boot-update'
  'live-root.sh'
  'live.conf'
  'module-setup.sh'
  'verify-live-image'
)
sha256sums=(
  '2755438fbe2fbdf8836429c8ac5d6f13a093f723e9814c92ba3417f7529bef65'
  '84a5729ec34807c789c8ec8cad6955d1120a53c45ccfc217d08fb991e54067ca'
  'b32cbdec21d068c6c23a0a0fd3fdca2982ed378d80b16ae2d998b62bbabff967'
  '3a8807cef4c6dc0d2ef29e9ee4ef246e46203ae01371511abd6d81d4283b6da9'
  '80587bb42107d9794ca18c7c9d04c34aba2aaf9f8cfb5f91bc850aa85b6ae0a2'
  'ab440090615d94ecac8526a8c12a5a02ac2f118a85ccd595e7499345d8c67437'
  'a652f93b752d464be23521f2e2296cb62c884a96f87b49b5321824e5a5076857'
  '04b447e3c7129b1d50557102c0c264a528079861ed158e35c8ce14f93decfb99'
  '8eb5bf879dd79a24aedfa868ba820f8c3593068e668e5188be2f495ddeb6db5b'
  'f4c600489e7fc94519dc66f902a863280ce6eb7d108568bc8f35a423d5d56a43'
  'fef72a77838a03d0aadbf800d55e25f5f6b8c570abe112eab8427598a20d9f27'

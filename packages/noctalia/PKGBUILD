# Maintainer: Devario maintainers

pkgname=noctalia
pkgver=5.0.0.r0.g50f0f09
pkgrel=1
pkgdesc="Noctalia v5 Wayland desktop shell"
arch=('x86_64')
url="https://github.com/noctalia-dev/noctalia"
license=('MIT')
depends=(
  'wayland'
  'wayland-protocols'
  'libglvnd'
  'freetype2'
  'fontconfig'
  'cairo'
  'pango'
  'harfbuzz'
  'libxkbcommon'
  'glib2'
  'libsecret'
  'libsodium'
  'sdbus-cpp'
  'libpipewire'
  'pipewire'
  'wireplumber'
  'polkit'
  'pam'
  'curl'
  'libwebp'
  'libjxl'
  'libsndfile'
  'librsvg'
  'libqalculate'
  'libxml2'
  'md4c'
  'tomlplusplus'
  'libical'
  'nlohmann-json'
  'jemalloc'
  'git'
)
makedepends=('meson' 'ninja' 'pkgconf' 'stb')
optdepends=(
  'gnome-keyring: Secret Service provider for credentials and encrypted state'
  'upower: battery and power-device integration'
  'ddcutil: external monitor brightness control'
)
_commit='50f0f095053a4b5c10874c4e7080f55dc15d3b38'
source=("noctalia-${_commit}.tar.gz")
sha256sums=('bcc34b2cfcb3650fa4e0197625c88918d5411c8a1532b9652497e205e491217c')

prepare() {
  # The extracted release snapshot has no nested Git metadata. Embed the
  # audited revision as Meson's deterministic VCS fallback instead of letting
  # Git discover the enclosing Devario worktree.
  sed -i "s/fallback: 'unknown'/fallback: '${_commit}'/" \
    "$srcdir/noctalia-5.0.0/meson.build"
  sed -i \
    "s|meson.project_source_root() / 'assets'|get_option('prefix') / get_option('datadir') / 'noctalia' / 'assets'|" \
    "$srcdir/noctalia-5.0.0/meson.build"
}

build() {
  # Devario packages must run on generic x86-64 hardware even when the build
  # host's makepkg policy requests native CPU tuning.
  export CFLAGS="$CFLAGS -march=x86-64 -mtune=generic"
  export CXXFLAGS="$CXXFLAGS -march=x86-64 -mtune=generic"
  export GIT_CEILING_DIRECTORIES="$srcdir"

  meson setup "$srcdir/build" "$srcdir/noctalia-5.0.0" \
    --prefix=/usr \
    --buildtype=release \
    --wrap-mode=nodownload \
    -Dnative_optimizations=false \
    -Dtests=disabled \
    -Djemalloc=enabled
  meson compile -C "$srcdir/build"
}

check() {
  "$srcdir/build/noctalia" --version | grep -F 'v5.0.0' >/dev/null
  meson test -C "$srcdir/build" --print-errorlogs
}

package() {
  DESTDIR="$pkgdir" meson install -C "$srcdir/build"

  install -Dm644 "$srcdir/noctalia-5.0.0/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/noctalia-5.0.0/third_party/fzy/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/fzy-LICENSE"
  install -Dm644 "$srcdir/noctalia-5.0.0/third_party/luau/LICENSE.txt" \
    "$pkgdir/usr/share/licenses/$pkgname/luau-LICENSE"
  install -Dm644 "$srcdir/noctalia-5.0.0/third_party/luau/lua_LICENSE.txt" \
    "$pkgdir/usr/share/licenses/$pkgname/lua-LICENSE"
  install -Dm644 "$srcdir/noctalia-5.0.0/third_party/material_color_utilities/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/material-color-utilities-LICENSE"
  install -Dm644 "$srcdir/noctalia-5.0.0/third_party/wuffs/LICENSE-APACHE" \
    "$pkgdir/usr/share/licenses/$pkgname/wuffs-LICENSE-APACHE"
  install -Dm644 "$srcdir/noctalia-5.0.0/third_party/wuffs/LICENSE-MIT" \
    "$pkgdir/usr/share/licenses/$pkgname/wuffs-LICENSE-MIT"
  install -Dm644 "$srcdir/noctalia-5.0.0/PACKAGING.md" \
    "$pkgdir/usr/share/doc/$pkgname/PACKAGING.md"
}

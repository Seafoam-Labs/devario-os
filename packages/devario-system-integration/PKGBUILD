  '{"path":"usr/lib/systemd/system/pearl-greeter.service.d/20-devario-gpu-driver.conf","from":"unowned","optional":true}'
  '{"path":"usr/lib/systemd/system/pearl-greeter.service.d/30-plymouth.conf","from":"unowned","optional":true}'
  '{"path":"usr/lib/systemd/user/wayland-wm@aqueous\\x2dwm.service.d/20-devario-gpu.conf","from":"unowned","optional":true}'

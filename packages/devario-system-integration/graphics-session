#!/usr/bin/python3 -I
"""Apply startup graphics workarounds only to the launched process tree."""
import os
import json
from pathlib import Path
import re
import subprocess
import sys


PREFERENCE_VARIABLE = 'AQUEOUS_RENDER_GPU_PREFERENCE'
PREFERENCES = ('auto', 'integrated', 'discrete')


def machine_type(root=Path('/sys/class/dmi/id')):
    """Classify only known physical chassis; never infer GPU type from vendor."""
    try:
        virtual = subprocess.run(['systemd-detect-virt', '--quiet'],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                 check=False, timeout=2)
        if virtual.returncode != 1:
            return 'unknown'
        chassis = int((root / 'chassis_type').read_text().strip())
    except (OSError, ValueError, subprocess.SubprocessError):
        return 'unknown'
    if chassis in (8, 9, 10, 14, 30, 31, 32):
        return 'laptop'
    if chassis in (3, 4, 5, 6, 7, 13, 15, 16, 35, 36):
        return 'desktop'
    return 'unknown'


def render_preference(environment, config=Path('/etc/devario/gpu-policy.json')):
    """Environment overrides config; chassis policy is a soft renderer hint."""
    requested = environment.get(PREFERENCE_VARIABLE)
    origin = 'environment'
    if requested is None:
        origin = 'configuration'
        try:
            settings = json.loads(config.read_text())
            requested = settings['render_preference']
            if not isinstance(requested, str):
                raise ValueError('render_preference must be a string')
        except FileNotFoundError:
            requested, origin = 'chassis', 'default'
        except (OSError, ValueError, KeyError, TypeError) as error:
            print(f'graphics-session: invalid GPU policy: {error}; using auto', file=sys.stderr)
            requested = 'auto'
    allowed = PREFERENCES if origin == 'environment' else (*PREFERENCES, 'chassis')
    if requested not in allowed:
        print(f'graphics-session: invalid render preference {requested!r}; using auto', file=sys.stderr)
        requested = 'auto'
    chassis = machine_type() if requested == 'chassis' else 'unchecked'
    preference = {'laptop': 'integrated', 'desktop': 'discrete'}.get(chassis, 'auto') \
        if requested == 'chassis' else requested
    override = environment.get('WLR_RENDER_DRM_DEVICE', 'none')
    print(f'graphics-session: chassis={chassis} policy={requested} source={origin} '
          f'render_preference={preference} explicit_render_device={override}', file=sys.stderr)
    return preference


def virtio_only(root=Path('/sys/class/drm')):
    drivers = []
    for card in root.glob('card*'):
        if not re.fullmatch(r'card[0-9]+', card.name):
            continue
        try:
            driver = (card / 'device/driver').resolve(strict=True).name
        except OSError:
            return False
        # The firmware framebuffer can coexist with the real virtio display.
        if driver != 'simple-framebuffer':
            drivers.append(driver)
    # PCI virtio DRM cards expose the parent transport's driver here; other
    # virtio transports expose virtio_gpu directly.
    return bool(drivers) and all(driver in ('virtio_gpu', 'virtio-pci') for driver in drivers)


def startup_environment(environment):
    environment = dict(environment)
    environment[PREFERENCE_VARIABLE] = render_preference(environment)
    mesa = '/usr/share/glvnd/egl_vendor.d/50_mesa.json'
    if Path(mesa).is_file():
        detected = subprocess.run(['/usr/lib/devario/gpu-driver-setup', '--detect'],
                                  stdout=subprocess.DEVNULL, check=False)
        # 1 means successful enumeration with no NVIDIA display controller;
        # a failed probe must never hide a potentially usable driver.
        if detected.returncode == 1:
            environment.setdefault('__EGL_VENDOR_LIBRARY_FILENAMES', mesa)
            environment.setdefault('VK_LOADER_DRIVERS_DISABLE', '*nvidia*')
    if virtio_only():
        environment.setdefault('MESA_LOADER_DRIVER_OVERRIDE', 'zink')
    return environment


def main(args):
    if args == ['--detect-virtio']:
        return 0 if virtio_only() else 1
    if not args:
        raise SystemExit('Usage: graphics-session --detect-virtio | COMMAND [ARG ...]')
    environment = startup_environment(os.environ)
    os.execvpe(args[0], args, environment)


if __name__ == '__main__':
    raise SystemExit(main(sys.argv[1:]))

// Permit the Devario live user to start Calamares, including from UWSM-managed
// processes that Polkit cannot associate with the active logind session.
// This file is removed from the installed system by prepare_target.conf.
polkit.addRule(function(action, subject) {
    if (action.id == "io.calamares.calamares.pkexec.run" &&
        subject.user == "liveuser") {
        return polkit.Result.YES;
    }
});

[Unit]
Description=Initialize the Shelly package-manager keyring
Requires=shelly-storage-migrate.service
After=shelly-storage-migrate.service time-sync.target
Before=greetd.service
ConditionPathExists=!/var/lib/devario/shelly-keyring.ready

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/shelly keyring init
ExecStart=/usr/bin/shelly keyring populate archlinux devario-core
ExecStart=/usr/bin/install -Dm644 /dev/null /var/lib/devario/shelly-keyring.ready

[Install]
WantedBy=multi-user.target

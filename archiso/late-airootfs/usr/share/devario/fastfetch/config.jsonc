      "format": "{pacman} (Shelly)"
    },
    "shell",
    "display",
    "de",
    "wm",
    "theme",
    "icons",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "locale",
    "break",
    "colors"
  ]
}

[Unit]
Description=Initialize the Shelly package-manager keyring
After=time-sync.target
Before=pearl-greeter.service
ConditionPathExists=!/var/lib/devario/shelly-keyring.ready

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/shelly keyring init
ExecStart=/usr/bin/shelly keyring populate devario-core
ExecStart=/usr/bin/install -Dm644 /dev/null /var/lib/devario/shelly-keyring.ready

[Install]
WantedBy=multi-user.target

// Permit installer elevation and disk discovery for the Devario live user,
// including UWSM processes outside the active logind session scope.
// This file is removed from the installed system by prepare_target.conf.
polkit.addRule(function(action, subject) {
    if (subject.user == "liveuser") {
        if (action.id == "org.kde.kpmcore.externalcommand.init") {
            return polkit.Result.YES;
        }

        // The Wayland launcher validates the socket and runs only Calamares.
        if (action.id == "org.freedesktop.policykit.exec" &&
            action.lookup("program") == "/usr/lib/devario/start-installer" &&
            action.lookup("user") == "root") {
            return polkit.Result.YES;
        }

        // pkexec can use its generic action if the Calamares action is not
        // selected. Both paths must execute exactly Calamares as root.
        if ((action.id == "io.calamares.calamares.pkexec.run" ||
             action.id == "org.freedesktop.policykit.exec") &&
            action.lookup("program") == "/usr/bin/calamares" &&
            action.lookup("user") == "root") {
            return polkit.Result.YES;
        }
    }
});

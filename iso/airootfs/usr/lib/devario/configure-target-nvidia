"""Configure supported NVIDIA hardware, or prune NVIDIA from non-NVIDIA targets."""
import argparse
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

HELPER = "/usr/lib/devario/configure-target-nvidia"
SUPPORT = Path("/usr/share/devario/nvidia-supported-gpus.json")
MODULES = ("nvidia", "nvidia_modeset", "nvidia_uvm", "nvidia_drm")
FIRMWARE = ("gsp_tu10x.bin", "gsp_ga10x.bin", "ucodes_tu10x.bin", "ucodes_ga10x.bin")


def log(message):
    print(f"Devario NVIDIA: {message}", flush=True)


def output(*args, env=None):
    options = {"env": env} if env is not None else {}
    return subprocess.check_output(args, text=True, **options).strip()


def detect():
    result = subprocess.run(["/usr/lib/devario/gpu-driver-setup", "--detect"],
                            text=True, stdout=subprocess.PIPE, check=False)
    if result.returncode == 1:
        return []
    if result.returncode != 0:
        raise RuntimeError("Cannot inspect PCI hardware; detection did not complete")
    root = Path(os.environ.get("DEVARIO_PCI_DEVICES_ROOT", "/sys/bus/pci/devices"))
    devices = []
    for address in result.stdout.splitlines():
        if not re.fullmatch(r"[0-9a-fA-F]{4}:[0-9a-fA-F]{2}:[0-9a-fA-F]{2}\.[0-7]", address):
            raise RuntimeError("Invalid PCI address from detector")
        ids = []
        for field in ("device", "subsystem_vendor", "subsystem_device"):
            value = (root / address / field).read_text().strip().lower()
            if not re.fullmatch(r"0x[0-9a-f]{4}", value):
                raise RuntimeError(f"Invalid {field} for {address}")
            ids.append(value[2:])
        devices.append({"address": address, "ids": ids})
    if not devices:
        raise RuntimeError("Detector returned success without a display controller")
    return devices


def check_support(devices, support):
    supported = set(support["pciIds"])
    for device in devices:
        ids = device["ids"]
        if len(ids) != 3 or any(not re.fullmatch(r"[0-9a-f]{4}", i) for i in ids):
            raise RuntimeError("Malformed PCI device information")
        if ids[0] not in supported and " ".join(ids) not in supported:
            raise RuntimeError(f"Unsupported NVIDIA GPU {device['address']} ({' '.join(ids)}): "
                               f"not supported by the {support['driverVersion']} open driver")
        log(f"supported GPU {device['address']} ({' '.join(ids)})")


def installed_packages(env=None):
    args = ("shelly", "list", "standard", "--show-hidden", "--json")
    listing = output(*args) if env is None else output(*args, env=env)
    inventory = json.loads(listing)
    if not isinstance(inventory, list):
        raise RuntimeError("Shelly did not return an installed package list")
    return {p["Name"]: p["Version"] for p in inventory}


def check_packages(version, packages=None):
    if packages is None:
        packages = installed_packages()
    for name in ("nvidia-open-dkms", "nvidia-utils", "dkms", "gcc", "make", "patch"):
        if name not in packages:
            raise RuntimeError(f"Offline installation payload is missing {name}")
        log(f"{name} {packages[name]}")
    for name in ("nvidia-open-dkms", "nvidia-utils"):
        upstream = packages[name].split(":")[-1].rsplit("-", 1)[0]
        if upstream != version:
            raise RuntimeError(f"{name} must be {version}, found {packages[name]}")
    return packages


def updated_support(root, packages):
    # The signed nvidia-open-dkms package carries the upstream support table
    # with its source. Never apply the ISO's older table to a newer driver.
    version = packages.get("nvidia-open-dkms", "").split(":")[-1].rsplit("-", 1)[0]
    if not re.fullmatch(r"\d+\.\d+\.\d+", version):
        raise RuntimeError("Missing or invalid installed NVIDIA driver version")
    readme = (root / f"usr/src/nvidia-{version}/README.md").read_text()
    if not re.search(r"\bversion\s+" + re.escape(version) + r"\.", readme):
        raise RuntimeError("Installed NVIDIA support table does not match the driver version")
    if "## Compatible GPUs\n" not in readme:
        raise RuntimeError("Installed NVIDIA sources have no compatible GPU table")
    section = readme.split("## Compatible GPUs\n", 1)[1].split("\n## ", 1)[0]
    devices = set()
    for line in section.splitlines():
        fields = line.split("|")
        if len(fields) == 4:
            value = fields[2].strip()
            if re.fullmatch(r"[0-9A-Fa-f]{4}(?: [0-9A-Fa-f]{4} [0-9A-Fa-f]{4})?", value):
                devices.add(value.lower())
    if not devices:
        raise RuntimeError("Installed NVIDIA compatible GPU table is empty")
    return {"driverVersion": version, "pciIds": sorted(devices)}


def check_payload(devices, root=Path("/"), updated=False):
    packages = installed_packages() if updated else None
    support = (updated_support(root, packages) if updated else
               json.loads((root / SUPPORT.relative_to("/")).read_text()))
    version = support["driverVersion"]
    check_support(devices, support)
    packages = check_packages(version, packages)
    # Use exactly the same kernel selection contract as prepare-target-kernel
    # and boot-update. No uname or assumptions about the running live kernel.
    kernel = output("bash", "-eu", "-c",
                    'source /usr/lib/devario/kernel.sh; '
                    'devario_kernel_select /usr/lib/modules linux-devario; '
                    'printf "%s" "$DEVARIO_KERNEL_VERSION"')
    if not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9._+-]*", kernel):
        raise RuntimeError("Invalid target kernel version")
    for name in ("linux-devario", "linux-devario-headers"):
        if name not in packages:
            raise RuntimeError(f"Offline installation payload is missing {name}")
    if packages["linux-devario"] != packages["linux-devario-headers"]:
        raise RuntimeError("Target kernel and header package versions differ")
    build = root / "usr/lib/modules" / kernel / "build"
    if not (build / "Makefile").is_file() or (build / "include/config/kernel.release").read_text().strip() != kernel:
        raise RuntimeError(f"Headers do not match target kernel {kernel}")
    if not (root / f"usr/src/nvidia-{version}/dkms.conf").is_file():
        raise RuntimeError(f"Missing NVIDIA {version} DKMS sources")
    for firmware in FIRMWARE:
        base = root / f"usr/lib/firmware/nvidia/{version}/{firmware}"
        if not any(Path(str(base) + suffix).is_file() for suffix in ("", ".zst", ".xz")):
            raise RuntimeError(f"Missing NVIDIA firmware {base}")
    log(f"verified {'updated' if updated else 'offline'} payload for target kernel {kernel}")
    return kernel, version


def modules_ready(kernel, version):
    try:
        for module in MODULES:
            if output("modinfo", "-k", kernel, "-F", "version", module) != version:
                return False
            if output("modinfo", "-k", kernel, "-F", "vermagic", module).split()[0] != kernel:
                return False
        return output("modinfo", "-k", kernel, "-F", "license", "nvidia") == "Dual MIT/GPL"
    except (subprocess.CalledProcessError, IndexError):
        return False


def atomic_write(path, text):
    path = Path(path)
    if path.is_symlink():
        raise RuntimeError(f"Refusing to replace configuration symlink: {path}")
    path.parent.mkdir(parents=True, exist_ok=True)
    metadata = path.stat() if path.exists() else None
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as stream:
            stream.write(text)
            stream.flush()
            os.fchmod(stream.fileno(), metadata.st_mode & 0o777 if metadata else 0o644)
            if metadata:
                os.fchown(stream.fileno(), metadata.st_uid, metadata.st_gid)
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def enable_kms(config=Path("/etc/devario-dracut.conf"),
               modprobe=Path("/etc/modprobe.d/devario-nvidia.conf")):
    previous = config.read_text() if config.exists() else ""
    lines = [line for line in previous.splitlines(keepends=True)
             if not re.match(r"^\s*(?:export\s+)?NVIDIA_EARLY_KMS\s*=", line)]
    text = "".join(lines)
    if text and not text.endswith("\n"):
        text += "\n"
    text += 'NVIDIA_EARLY_KMS="true"\n'
    atomic_write(modprobe, "# Managed by the Devario installer.\noptions nvidia_drm modeset=1\n")
    atomic_write(config, text)



def disable_kms(config=Path("/etc/devario-dracut.conf"),
                modprobe=Path("/etc/modprobe.d/devario-nvidia.conf")):
    # A copied live installation must never force early NVIDIA KMS on a system
    # where Calamares has selected the non-NVIDIA driver policy.
    previous = config.read_text() if config.exists() else ""
    lines = [line for line in previous.splitlines(keepends=True)
             if not re.match(r"^\s*(?:export\s+)?NVIDIA_EARLY_KMS\s*=", line)]
    text = "".join(lines)
    if text and not text.endswith("\n"):
        text += "\n"
    text += 'NVIDIA_EARLY_KMS="false"\n'
    if not config.exists() or config.read_text() != text:
        atomic_write(config, text)
    if modprobe.exists() or modprobe.is_symlink():
        # Do not destroy a non-installer-owned modprobe configuration.
        if modprobe.is_symlink() or modprobe.read_text() != (
                "# Managed by the Devario installer.\noptions nvidia_drm modeset=1\n"):
            raise RuntimeError(f"Refusing to remove non-installer-owned NVIDIA configuration: {modprobe}")
        modprobe.unlink()


def remove_unused_nvidia():
    # Installed files come from unpackfs. Use the native RLPM transaction,
    # never unlink package payloads or modify Shelly's database by hand.
    names = ("nvidia-open-dkms", "nvidia-utils")
    # Force the same native backend for BOTH inventories and the transaction.
    # Do not mutate the user's persistent Shelly configuration.
    with tempfile.TemporaryDirectory(prefix="devario-nvidia-rlpm-") as directory:
        conf = Path(directory) / "shelly"
        conf.mkdir(mode=0o700)
        # Only NativePackageBackend is honoured by the Shelly CLI.
        # Cascade must be disabled via the remove command's arguments.
        (conf / "config.json").write_text(json.dumps({
            "NativePackageBackend": "rlpm",
        }) + "\n")
        env = os.environ.copy()
        env["XDG_CONFIG_HOME"] = directory
        before = installed_packages(env=env)
        present = [name for name in names if name in before]
        if not present:
            log("no NVIDIA packages to remove from this target")
            return
        log("removing unnecessary NVIDIA packages through RLPM: " + ", ".join(present))
        try:
            subprocess.run(["shelly", "remove", "standard", *present,
                            "--no-cascade", "--no-confirm"],
                           env=env, stdin=subprocess.DEVNULL, check=True)
        except subprocess.CalledProcessError as error:
            raise RuntimeError(
                "RLPM could not remove the NVIDIA packages. Ensure the ISO includes "
                "devario-aqueous-desktop 1-15 or newer with NVIDIA as optional "
                "rather than hard dependencies; rebuild the metapackage and ISO before retrying."
            ) from error
        after = installed_packages(env=env)
        remaining = [name for name in names if name in after]
        if remaining:
            raise RuntimeError("RLPM reported success but NVIDIA packages remain: " + ", ".join(remaining))
    log("non-NVIDIA target is free of NVIDIA driver packages")


def configure(devices, updated=False):
    if not devices:
        # Clear any live-image KMS policy before a removal transaction: on an
        # already bootable target, an ALPM hook may rebuild initramfs.
        disable_kms()
        remove_unused_nvidia()
        return
    kernel, version = check_payload(devices, updated=True) if updated else check_payload(devices)
    if not modules_ready(kernel, version):
        log(f"building NVIDIA {version} modules for {kernel}; DKMS logs are in /var/lib/dkms")
        subprocess.run(["dkms", "autoinstall", "-k", kernel], check=True)
    subprocess.run(["depmod", "-a", kernel], check=True)
    if not modules_ready(kernel, version):
        raise RuntimeError(f"NVIDIA {version} modules are incomplete or incompatible with {kernel}")
    enable_kms()
    log(f"enabled NVIDIA_EARLY_KMS for {version} / {kernel}")


def preflight(devices):
    if not devices:
        log("no NVIDIA display controllers detected; skipping NVIDIA payload preflight")
        return
    # Inspect the pristine payload copied by unpackfs. Shelly's read-only
    # inventory command still initializes user state and resolves paths via
    # /proc/self/fd. Supply those in a private mount namespace, without writing
    # to the source image or exposing these mounts to unpackfs. The namespace
    # releases its mounts on both success and failure; no live mounts change.
    result = subprocess.run([
        "unshare", "--mount", "--propagation", "private", "--fork", "--kill-child",
        "sh", "-eu", "-c", '''
root=/run/devario/install-root
mount -t proc -o ro,nosuid,nodev,noexec proc "$root/proc"
mount -t tmpfs -o mode=0700,nosuid,nodev tmpfs "$root/root"
mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs "$root/var/log"
exec env -i HOME=/root PATH=/usr/bin:/bin LC_ALL=C \\
    chroot "$root" "$1" --check-payload
''', "devario-nvidia-preflight", HELPER], input=json.dumps(devices), text=True, check=False)
    if result.returncode != 0:
        raise RuntimeError(f"Pristine NVIDIA payload check failed (exit {result.returncode}); "
                           "see command output above")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    modes = parser.add_mutually_exclusive_group()
    for name in ("preflight", "check-payload", "configure", "configure-updated"):
        modes.add_argument(f"--{name}", action="store_const", const=name, dest="mode")
    mode = parser.parse_args().mode or "configure"
    if mode == "check-payload":
        check_payload(json.load(sys.stdin))
        return
    devices = detect()
    if mode == "preflight":
        preflight(devices)
    elif mode == "configure-updated":
        configure(devices, updated=True)
    else:
        configure(devices)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, RuntimeError, subprocess.CalledProcessError) as error:
        print(f"Devario NVIDIA installation failed: {error}", file=sys.stderr)
        sys.exit(1)

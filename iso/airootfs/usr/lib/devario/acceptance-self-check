set -u
root=/ mode='' firmware='' edition=''
while (( $# )); do
  case "$1" in
    --root) root="$2"; shift 2 ;;
    --mode) mode="$2"; shift 2 ;;
    --firmware) firmware="$2"; shift 2 ;;
    --edition) edition="$2"; shift 2 ;;
    *) exit 2 ;;
  esac
done
if [[ -z "$mode" || -z "$firmware" || -z "$edition" ]]; then
  request='/sys/firmware/qemu_fw_cfg/by_name/opt/org.devario/acceptance/raw'
  [[ -r "$request" ]] || exit 0
  IFS=' ' read -r mode firmware edition extra < "$request"
  [[ -z "${extra:-}" ]] || exit 2
fi
mode="${mode#mode=}"; firmware="${firmware#firmware=}"; edition="${edition#edition=}"
[[ "$mode" == live || "$mode" == installed ]] || exit 2
[[ "$firmware" == bios || "$firmware" == uefi ]] || exit 2
[[ "$edition" == community || "$edition" == managed ]] || exit 2

failures=()
fail() { failures+=("$*"); }
root_path() { printf '%s%s\n' "${root%/}" "$1"; }
os_release="$(root_path /etc/os-release)"; shelly_conf="$(root_path /etc/shelly.conf)"
keyring_ready="$(root_path /var/lib/devario/shelly-keyring.ready)"
installer_rule="$(root_path /etc/polkit-1/rules.d/49-devario-live-installer.rules)"
[[ -r "$os_release" ]] || fail 'missing /etc/os-release'
[[ -r "$shelly_conf" ]] || fail 'missing /etc/shelly.conf'
[[ -f "$keyring_ready" && ! -L "$keyring_ready" ]] || fail 'Shelly keyring initialization did not complete'

if [[ -r "$os_release" ]]; then
  actual_edition="$(sed -nE 's/^VARIANT_ID="?([^"[:space:]]+)"?$/\1/p' "$os_release")"
  [[ "$actual_edition" == "$edition" ]] || fail "VARIANT_ID is ${actual_edition:-missing}, expected $edition"
fi

section_siglevel() {
  local section="$1"
  awk -v wanted="$section" '
    /^[[:space:]]*\[/ {
      current=$0; gsub(/^[[:space:]]*\[|\][[:space:]]*$/, "", current); next
    }
    current == wanted && /^[[:space:]]*SigLevel[[:space:]]*=/ {
      value=$0; sub(/^[^=]*=[[:space:]]*/, "", value); sub(/[[:space:]]*#.*/, "", value)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value); print value
    }
  ' "$shelly_conf"
}
section_servers() {
  local section="$1"
  awk -v wanted="$section" '
    /^[[:space:]]*\[/ {current=$0; gsub(/^[[:space:]]*\[|\][[:space:]]*$/, "", current); next}
    current == wanted && /^[[:space:]]*Server[[:space:]]*=/ {
      value=$0; sub(/^[^=]*=[[:space:]]*/, "", value)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value); print value
    }
  ' "$shelly_conf"
}
section_count() { grep -Ec "^[[:space:]]*\\[$1\\][[:space:]]*$" "$shelly_conf"; }
require_repository() {
  local section="$1" count sig server
  count="$(section_count "$section")"
  [[ "$count" == 1 ]] || { fail "repository [$section] occurs $count times"; return; }
  sig="$(section_siglevel "$section")"
  [[ "$sig" == Required ]] || fail "repository [$section] must declare exactly SigLevel = Required"
  server="$(section_servers "$section")"
  if [[ "$(section_servers "$section" | wc -l)" != 1 \
    || ! "$server" =~ ^https://[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(:[0-9]{1,5})?(/[A-Za-z0-9._~!$\&\'\(\)*+,\;=:%/-]*)?$ \
    || "$server" == *'@'* || "$server" == *'?'* || "$server" == *'#'* || "$server" == *'\'* \
    || "$server" == */../* || "$server" == */./* ]]; then
    fail "repository [$section] must have exactly one credential-free HTTPS Server"
  fi
}
if [[ -r "$shelly_conf" ]]; then
  require_repository devario-core
  if [[ "$edition" == managed ]]; then
    require_repository devario-managed
  elif grep -Eqi 'devario-managed|managed\.seafoam|tenant|enrollment' "$shelly_conf"; then
    fail 'Community ALPM configuration contains managed material'
  fi
fi

if [[ "$root" == / ]]; then
  if [[ "$firmware" == uefi ]]; then [[ -d /sys/firmware/efi ]] || fail 'UEFI runtime was not detected'
  else [[ ! -d /sys/firmware/efi ]] || fail 'BIOS runtime unexpectedly exposes EFI'; fi
fi
if [[ "$mode" == installed ]]; then
  [[ "$firmware" == uefi ]] || fail 'installed Devario requires UEFI'
  [[ -f "$(root_path /var/lib/devario/systemd-boot-installed)" ]] || fail 'systemd-boot installation marker is missing'
  for boot_file in /boot/loader/entries/devario.conf /boot/loader/entries/devario-fallback.conf /boot/EFI/systemd/systemd-bootx64.efi /boot/EFI/BOOT/BOOTX64.EFI; do
    [[ -s "$(root_path "$boot_file")" ]] || fail "missing installed boot file: $boot_file"
  done
  [[ -s "$(root_path /etc/machine-id)" ]] || fail 'installed system lacks a machine ID'
  [[ -s "$(root_path /etc/fstab)" ]] || fail 'installed system lacks fstab'
  [[ ! -e "$(root_path /run/devario/live)" ]] || fail 'installed system is still a Devario live root'
  [[ ! -e "$installer_rule" && ! -L "$installer_rule" ]] || fail 'installed system retains live installer authorization'
else
  [[ -x "$(root_path /usr/bin/calamares)" || "$root" != / ]] || fail 'live image lacks Calamares'
  [[ -s "$installer_rule" && ! -L "$installer_rule" ]] || fail 'live image lacks the installer authorization rule'
  if [[ "$root" == / ]]; then
    [[ -e /run/devario/live ]] || fail 'live image lacks the Devario dracut marker'
    mountpoint -q /run/devario/install-root || fail 'pristine installation source is not mounted'
    [[ "$(stat -c '%u:%a' /usr/bin/pkexec)" == 0:4755 ]] || fail 'pkexec must be owned by root with mode 4755'
    # Polkit requires a trusted caller to supply executable/target-user details.
    # Query as root for a liveuser process held open on a pipe, without creating
    # a logind session or allowing a prompt. The handshake ensures the subject
    # has dropped root privileges before its authorization is tested.
    coproc INSTALLER_SUBJECT {
      setpriv --reuid=liveuser --regid=liveuser --init-groups \
        sh -c 'echo "$$"; read -r finished'
    }
    installer_input=${INSTALLER_SUBJECT[1]} installer_output=${INSTALLER_SUBJECT[0]}
    installer_job=$INSTALLER_SUBJECT_PID
    if read -r -t 15 installer_pid <&"$installer_output" && [[ "$installer_pid" =~ ^[0-9]+$ ]]; then
      installer_start=$(awk '{print $22}' "/proc/$installer_pid/stat")
      installer_uid=$(id -u liveuser)
      for action in io.calamares.calamares.pkexec.run org.freedesktop.policykit.exec org.kde.kpmcore.externalcommand.init; do
        if ! timeout 15s pkcheck --process "$installer_pid,$installer_start,$installer_uid" \
          --action-id "$action" -d program /usr/bin/calamares -d user root; then
          fail "live installer requires authentication or authorization failed: $action"
        fi
      done
    else
      fail 'could not start the liveuser authorization probe'
    fi
    exec {installer_input}>&- {installer_output}<&-
    wait "$installer_job" || true
  fi
fi

marker="mode=$mode firmware=$firmware edition=$edition"
if (( ${#failures[@]} )); then
  printf 'Acceptance failure: %s\n' "${failures[@]}" >&2
  printf 'DEVARIO_ACCEPTANCE:FAIL %s\n' "$marker"
  status=1
else
  printf 'DEVARIO_ACCEPTANCE:PASS %s\n' "$marker"
  status=0
fi
if [[ "$root" == / && -r /sys/firmware/qemu_fw_cfg/by_name/opt/org.devario/acceptance/raw ]]; then
  systemctl --no-block poweroff >/dev/null 2>&1 || true
fi
exit "$status"

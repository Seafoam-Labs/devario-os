{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/devario/fastfetch/devario-fish.txt",
    "color": {
      "1": "#62c6b5",
      "2": "#00a9e8"
    },
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "color": { "keys": "#62c6b5", "title": "#62c6b5" }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    {
      "type": "packages",
      "format": "{shelly} (Shelly)"
    },
    "shell",
    "display",
    { "type": "wm", "key": "WM" },
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk"
  ]
}

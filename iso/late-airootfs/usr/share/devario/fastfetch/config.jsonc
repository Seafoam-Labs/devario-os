{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "/usr/share/devario/fastfetch/devario-logo.png",
    "width": 24,
    "padding": {
      "top": 0,
      "right": 0,
      "bottom": 1
    },
    "color": {
      "1": "#62c6b5",
      "2": "#00a9e8"
    },
    "position": "top"
  },
  "display": {
    "separator": " ▸ ",
    "color": {
      "keys": "#62c6b5",
      "title": "#62c6b5"
    }
  },
  "modules": [
    {
      "type": "break"
    },
    {
      "type": "os",
      "key": "◎ OS"
    },
    {
      "type": "kernel",
      "key": "◎ Kernel"
    },
    {
      "type": "de",
      "key": "◎ WM"
    },
    {
      "type": "wm",
      "key": "◎ Compositor"
    },
    {
      "type": "packages",
      "key": "◎ Packages",
      "format": "{shelly} (Shelly)"
    },
    {
      "type": "memory",
      "key": "◎ Ram"
    },
    {
      "type": "cpu",
      "key": "◎ CPU"
    },
    {
      "type": "gpu",
      "key": "◎ GPU"
    },
    {
      "type": "swap",
      "key": "◎ Swap"
    },
    {
      "type": "disk",
      "key": "◎ Disk"
    },
    {
      "type": "uptime",
      "key": "◎ Uptime"
    },
    {
      "type": "terminal",
      "key": "◎ Terminal"
    },
    {
      "type": "colors",
      "paddingLeft": 0,
      "symbol": "circle"
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Seafoam-Labs/devario-os/main/release/source-index.schema.json",
  "title": "Binary-to-corresponding-source index",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "packages"],
  "properties": {
    "$schema": {"const": "./source-index.schema.json"},
    "schemaVersion": {"const": 1},
    "packages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "version", "architecture", "packageBase", "binary", "sources"],
        "properties": {
          "name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
          "architecture": {"enum": ["any", "x86_64"]}, "packageBase": {"type": "string", "minLength": 1},
          "binary": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "sha256", "size"],
            "properties": {
              "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[^\\r\\n]+$"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "size": {"type": "integer", "minimum": 1}
            }
          },
          "sources": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["uri", "revision", "sha256", "correspondingSource"],
              "properties": {
                "uri": {"type": "string", "format": "uri", "pattern": "^(git\\+)?https://"}, "revision": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "correspondingSource": {"const": true}
              }
            }
          }
        }
      }
    }
  }
}

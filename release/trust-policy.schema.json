{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Seafoam-Labs/devario-os/main/release/trust-policy.schema.json",
  "title": "Devario release signing trust policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "purpose", "activeFingerprint", "approvedFingerprints", "forbiddenFingerprints"],
  "properties": {
    "$schema": {"const": "./trust-policy.schema.json"},
    "schemaVersion": {"const": 1},
    "purpose": {"enum": ["core-packages", "human-release-approval"]},
    "activeFingerprint": {
      "oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9A-F]{40,64}$"}]
    },
    "approvedFingerprints": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9A-F]{40,64}$"}
    },
    "forbiddenFingerprints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9A-F]{40,64}$"}
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Seafoam-Labs/devario-os/main/release/promotion-record.schema.json",
  "title": "Devario digest-only promotion record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidateSha256", "approvalSha256", "approvalSignatureSha256", "reproducibilitySha256", "acceptanceManifestSha256", "acceptanceEvidenceManifestSha256", "editionEvidence", "version", "edition", "coreCommit", "overlayCommit", "fromChannel", "targetChannel", "promotedAt", "artifactSetSha256", "metadataSetSha256", "artifacts", "metadata"],
  "properties": {
    "schemaVersion": {"const": 1},
    "candidateSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approvalSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approvalSignatureSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "version": {"type": "string", "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "reproducibilitySha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "acceptanceManifestSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "acceptanceEvidenceManifestSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "editionEvidence": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/namedBinding"}
      ]
    },
    "edition": {"enum": ["community", "managed"]},
    "coreCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "overlayCommit": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{40}$"}]},
    "fromChannel": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "targetChannel": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "promotedAt": {"type": "string", "format": "date-time"},
    "artifactSetSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "metadataSetSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifacts": {"$ref": "#/$defs/tree"},
    "metadata": {"$ref": "#/$defs/tree"}
  },
  "allOf": [
    {
      "if": {"properties": {"edition": {"const": "community"}}},
      "then": {"properties": {"editionEvidence": {"type": "null"}}},
      "else": {"properties": {"editionEvidence": {"$ref": "#/$defs/namedBinding"}}}
    }
  ],
  "$defs": {
    "namedBinding": {
      "type": "object", "additionalProperties": false, "required": ["name", "sha256"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "tree": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "file": {"oneOf": [{"$ref": "#/$defs/regularFile"}, {"$ref": "#/$defs/repositorySymlink"}]},
    "regularFile": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "size", "mode"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[^\\r\\n]+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size": {"type": "integer", "minimum": 1},
        "mode": {"type": "string", "pattern": "^[0-7]{3,4}$"}
      }
    },
    "repositorySymlink": {
      "type": "object", "additionalProperties": false, "required": ["path", "mode", "target"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?:[^\\r\\n]+/)?devario-(?:core|managed)\\.(?:db|files)(?:\\.sig)?$"},
        "mode": {"const": "120000"},
        "target": {"type": "string"}
      },
      "oneOf": [
        {"properties": {"path": {"pattern": "(?:^|/)devario-core\\.db$"}, "target": {"const": "devario-core.db.tar.zst"}}},
        {"properties": {"path": {"pattern": "(?:^|/)devario-core\\.files$"}, "target": {"const": "devario-core.files.tar.zst"}}},
        {"properties": {"path": {"pattern": "(?:^|/)devario-core\\.db\\.sig$"}, "target": {"const": "devario-core.db.tar.zst.sig"}}},
        {"properties": {"path": {"pattern": "(?:^|/)devario-core\\.files\\.sig$"}, "target": {"const": "devario-core.files.tar.zst.sig"}}},
        {"properties": {"path": {"pattern": "(?:^|/)devario-managed\\.db$"}, "target": {"const": "devario-managed.db.tar.zst"}}},
        {"properties": {"path": {"pattern": "(?:^|/)devario-managed\\.files$"}, "target": {"const": "devario-managed.files.tar.zst"}}},
        {"properties": {"path": {"pattern": "(?:^|/)devario-managed\\.db\\.sig$"}, "target": {"const": "devario-managed.db.tar.zst.sig"}}},
        {"properties": {"path": {"pattern": "(?:^|/)devario-managed\\.files\\.sig$"}, "target": {"const": "devario-managed.files.tar.zst.sig"}}}
      ]
    }
  }
}
